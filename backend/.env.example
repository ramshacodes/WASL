# Set to "false" to attempt live CAMARA sandbox calls. If a live call fails
# or these vars are missing, the adapter transparently falls back to demo
# responses — the demo will never break because of a network/API failure.
DEMO_MODE=true

# CAMARA / Nokia Network as Code sandbox
CAMARA_BASE_URL=
CAMARA_API_KEY=

# Optional — enables live Gemini-generated briefings. Without this, WASL
# uses a static (but still context-specific) fallback briefing.
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
